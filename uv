#!/bin/bash
set -eu -o pipefail

SCRIPT_FOLDER=$(dirname $(realpath $0))

VERSION=0.1.24
DOWNLOADS=${SCRIPT_FOLDER}/.downloads
UV=${DOWNLOADS}/uv-${VERSION}
UV_COMPRESSED=${DOWNLOADS}/uv-${VERSION}.tar.gz

if [ ! -d $DOWNLOADS ]; then
    mkdir -p ${DOWNLOADS}
fi

if [ ! -f $UV_COMPRESSED ]; then
    wget https://github.com/astral-sh/uv/releases/download/${VERSION}/uv-x86_64-unknown-linux-musl.tar.gz --output-document=${UV_COMPRESSED}
fi

if [ ! -f $UV ]; then
    # The release tarball already contains a single top-level
    # uv-x86_64-unknown-linux-musl/ directory, so --one-top-level is
    # redundant here — and on some CI runners its extra directory-creation
    # step fails with "Invalid cross-device link" (EXDEV). Extracting
    # straight into DOWNLOADS with -C avoids that code path entirely.
    tar -zxvf ${UV_COMPRESSED} -C ${DOWNLOADS}
    mv ${DOWNLOADS}/uv-x86_64-unknown-linux-musl/uv ${UV}
fi

$UV $*
